# Copy to .env (never committed), fill in, then:
#   set -a; . ./.env; set +a; python3 publish.py

# Ghost admin API, usually reached on the box that runs Ghost
GHOST_URL=http://127.0.0.1:2368
# the public host name Ghost is configured for (sent as Host / Origin)
GHOST_SITE=blog.example.com
# theme to activate if it is installed; leave as is to skip quietly
GHOST_THEME=alola-case

# a Ghost staff login with permission to publish
GHOST_EMAIL=demo@example.com
GHOST_PASSWORD=change-me
# ...or instead of the two lines above, a private file with
# "email: ..." and "password: ..." lines:
# GHOST_CREDS_FILE=~/secrets/ghost.md

# where the measurement scripts read their logs (defaults shown)
# CLAUDE_PROJECTS=~/.claude/projects
# INCIDENT_PROJECT=~/.claude/projects/-home-demo-www-dashbored
# OPENCODE_DB=~/.local/share/opencode/opencode.db
